# ---------------------------------------------------------------------------
# LandFlow — Supabase
# Copy to .env.local (git-ignored) and fill in. Both vars are REQUIRED for
# the app to talk to Supabase. If either is missing the app shows a clear
# error — it will NOT fall back to sample data, because a broken database
# that looks like a working site is the worst possible failure.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: shows a "Continue with Google" button on the login page.
# Leave blank to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: the public URL of the deployed site. Used for absolute URLs in
# emails and for the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
